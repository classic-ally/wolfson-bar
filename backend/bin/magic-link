#!/usr/bin/env python3
"""Mint a fresh magic-link login URL for any user in the dev database.

Usage:
    magic-link <email>          # full email match
    magic-link <name>           # short-name match against the dummy seed
                                # (e.g. `magic-link allison` → allison@example.test)

The script inserts a new row into magic_link_tokens with a 15-minute window
and prints the verification URL. Re-run to refresh.

DB path:    $DATABASE_PATH  (default: <repo-root>/wolfson_bar.db)
Sign-in origin: $MAGIC_LINK_ORIGIN  (default: http://localhost:3000)
"""

from __future__ import annotations

import os
import secrets
import sqlite3
import sys
from datetime import datetime
from pathlib import Path


def repo_root() -> Path:
    return Path(__file__).resolve().parent.parent.parent


def db_path() -> Path:
    return Path(os.environ.get("DATABASE_PATH", repo_root() / "wolfson_bar.db"))


def resolve_email(con: sqlite3.Connection, query: str) -> str | None:
    if "@" in query:
        row = con.execute("SELECT email FROM users WHERE email = ?", (query,)).fetchone()
        return row[0] if row else None

    # Short-name lookup: match the dummy-seed convention first, then fall back
    # to partial display-name match for any other user.
    candidates = [
        f"{query}@example.test",
        query,
    ]
    for c in candidates:
        row = con.execute("SELECT email FROM users WHERE email = ?", (c,)).fetchone()
        if row:
            return row[0]
    row = con.execute(
        "SELECT email FROM users WHERE email IS NOT NULL "
        "AND lower(display_name) LIKE lower(?) LIMIT 1",
        (f"%{query}%",),
    ).fetchone()
    return row[0] if row else None


def mint(email: str, con: sqlite3.Connection) -> str:
    token = f"dev-{secrets.token_urlsafe(12)}"
    row_id = f"dev-magic-{secrets.token_hex(4)}"
    now = datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S")
    con.execute(
        "INSERT INTO magic_link_tokens (id, email, token, created_at, used, ip_address) "
        "VALUES (?, ?, ?, ?, 0, '127.0.0.1')",
        (row_id, email, token, now),
    )
    con.commit()
    return token


def main(argv: list[str]) -> int:
    if len(argv) != 2 or argv[1] in ("-h", "--help"):
        print(__doc__, file=sys.stderr)
        return 1
    query = argv[1]
    db = db_path()
    if not db.exists():
        print(f"error: database not found at {db}. Boot the backend first.",
              file=sys.stderr)
        return 1

    origin = os.environ.get("MAGIC_LINK_ORIGIN", "http://localhost:3000")

    con = sqlite3.connect(db)
    try:
        email = resolve_email(con, query)
        if not email:
            print(f"error: no user matching '{query}' in {db}", file=sys.stderr)
            return 1
        token = mint(email, con)
    finally:
        con.close()

    print(f"{origin}/api/auth/magic-link/verify?token={token}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
